          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/suppliers/{{supplierId}}/suspend",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "suppliers", "{{supplierId}}", "suspend"]
            }
          }
        }
      ]
    },

