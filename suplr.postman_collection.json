            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  { \"name\": \"Extra Virgin Olive Oil\", \"unit\": \"liter\",  \"price_usd\": \"8.50\",  \"price_lbp\": \"765000\"  },\n  { \"name\": \"Sunflower Oil\",           \"unit\": \"liter\",  \"price_usd\": \"2.50\",  \"price_lbp\": \"225000\"  },\n  { \"name\": \"All-Purpose Flour\",       \"unit\": \"kg\",     \"price_usd\": \"1.20\",  \"price_lbp\": \"108000\"  },\n  { \"name\": \"Whole Wheat Flour\",       \"unit\": \"kg\",     \"price_usd\": \"1.50\",  \"price_lbp\": \"135000\"  },\n  { \"name\": \"White Sugar\",             \"unit\": \"kg\",     \"price_usd\": \"1.10\",  \"price_lbp\": \"99000\"   },\n  { \"name\": \"Basmati Rice\",            \"unit\": \"kg\",     \"price_usd\": \"2.80\",  \"price_lbp\": \"252000\"  },\n  { \"name\": \"Red Lentils\",             \"unit\": \"kg\",     \"price_usd\": \"2.20\",  \"price_lbp\": \"198000\"  },\n  { \"name\": \"Dried Chickpeas\",         \"unit\": \"kg\",     \"price_usd\": \"2.50\",  \"price_lbp\": \"225000\"  },\n  { \"name\": \"Sea Salt\",               \"unit\": \"kg\",     \"price_usd\": \"0.80\",  \"price_lbp\": \"72000\"   },\n  { \"name\": \"Tahini\",                 \"unit\": \"kg\",     \"price_usd\": \"5.50\",  \"price_lbp\": \"495000\"  }\n]",
