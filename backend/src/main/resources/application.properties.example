spring.application.name=suplr-backend
spring.datasource.url=${DB_URL}
spring.datasource.driver-class-name=org.postgresql.Driver
spring.datasource.username=${DB_USERNAME}
spring.datasource.password=${DB_PASSWORD}
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=false
spring.jackson.property-naming-strategy=SNAKE_CASE
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.data.redis.url=${REDIS_URL}
app.jwt.secret=${JWT_SECRET}
app.jwt.expiration-minutes=1440
app.cors.allowed-origins=${CORS_ORIGINS:http://localhost:3000}
app.email.from=${EMAIL_FROM:Suplr <noreply@example.com>}
app.email.smtp-host=${SMTP_HOST:smtp.gmail.com}
app.email.smtp-port=${SMTP_PORT:587}
app.email.smtp-user=${SMTP_USER:}
app.email.smtp-pass=${SMTP_PASS:}
app.r2.account-id=${R2_ACCOUNT_ID:}
app.r2.access-key-id=${R2_ACCESS_KEY_ID:}
app.r2.secret-access-key=${R2_SECRET_ACCESS_KEY:}
app.r2.bucket=${R2_BUCKET:suplr}
app.r2.public-url=${R2_PUBLIC_URL:}
app.webhook.secret=${WEBHOOK_SECRET:}
app.webhook.verify-token=${WEBHOOK_VERIFY_TOKEN:}
app.groq.api-key=${GROQ_API_KEY:}
app.lbp-rate=${LBP_RATE:90000}
